# ---------------------------------------------------------------------------
# Single source of configuration for the Argo learning lab.
# Every value can be overridden from the environment, e.g.  WORKERS=1 make up
# ---------------------------------------------------------------------------

# --- kind cluster -----------------------------------------------------------
CLUSTER_NAME="${CLUSTER_NAME:-argo-lab}"
WORKERS="${WORKERS:-2}"                       # number of worker nodes (0 = control-plane only)
# Newest image supported by kind v0.31. See https://github.com/kubernetes-sigs/kind/releases
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f}"
# Host ports mapped to ingress-nginx. 80/443 are the nicest (URLs without a port) but on this
# machine they are held by the "uki-local" kind cluster, so defaults avoid the clash.
HTTP_PORT="${HTTP_PORT:-8880}"
HTTPS_PORT="${HTTPS_PORT:-8443}"

# --- access -----------------------------------------------------------------
# *.localhost resolves to loopback on macOS, in Chrome/Firefox and on systemd-resolved Linux without
# any DNS or /etc/hosts changes. Alternatives: localtest.me / 127.0.0.1.nip.io (public wildcard DNS
# that answers 127.0.0.1; many home routers block such answers), or a real domain in /etc/hosts.
BASE_DOMAIN="${BASE_DOMAIN:-localhost}"

# --- git source for labs ----------------------------------------------------
# Push this folder to GitHub, set the URL here, then run `make init-labs`.
GIT_REPO_URL="${GIT_REPO_URL:-https://github.com/rozdolsky33/argo-lab.git}"
GIT_BRANCH="${GIT_BRANCH:-main}"

# --- component versions -----------------------------------------------------
INGRESS_NGINX_VERSION="${INGRESS_NGINX_VERSION:-controller-v1.15.1}"
ARGOCD_VERSION="${ARGOCD_VERSION:-v3.5.6}"
ARGO_ROLLOUTS_VERSION="${ARGO_ROLLOUTS_VERSION:-v1.10.1}"
ARGO_WORKFLOWS_VERSION="${ARGO_WORKFLOWS_VERSION:-v4.1.6}"
ARGO_EVENTS_VERSION="${ARGO_EVENTS_VERSION:-v1.9.11}"
ARGOCD_IMAGE_UPDATER_VERSION="${ARGOCD_IMAGE_UPDATER_VERSION:-v1.4.0}"
KUBE_PROMETHEUS_STACK_VERSION="${KUBE_PROMETHEUS_STACK_VERSION:-92.13.1}"
CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.21.3}"

# --- namespaces -------------------------------------------------------------
ARGOCD_NS="${ARGOCD_NS:-argocd}"
ARGO_ROLLOUTS_NS="${ARGO_ROLLOUTS_NS:-argo-rollouts}"
ARGO_WORKFLOWS_NS="${ARGO_WORKFLOWS_NS:-argo}"          # quick-start manifests hardcode "argo"
ARGO_EVENTS_NS="${ARGO_EVENTS_NS:-argo-events}"          # upstream install hardcodes "argo-events"
MONITORING_NS="${MONITORING_NS:-monitoring}"
CERT_MANAGER_NS="${CERT_MANAGER_NS:-cert-manager}"      # upstream install hardcodes "cert-manager"
INGRESS_NS="${INGRESS_NS:-ingress-nginx}"               # upstream install hardcodes "ingress-nginx"

# --- misc -------------------------------------------------------------------
PLUGIN_DIR="${PLUGIN_DIR:-$HOME/.local/bin}"          # where kubectl-argo-rollouts is installed
WAIT_TIMEOUT="${WAIT_TIMEOUT:-300s}"
